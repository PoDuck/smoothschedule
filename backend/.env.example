# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.smoothschedule.local
DJANGO_DEBUG=True

# Database
DATABASE_URL=postgres://smoothschedule:smoothschedule@localhost:5432/smoothschedule
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smoothschedule
POSTGRES_USER=smoothschedule
POSTGRES_PASSWORD=smoothschedule

# Redis
REDIS_URL=redis://localhost:6379/0

# Multi-Tenancy
TENANT_DOMAIN_SUFFIX=.smoothschedule.local
PLATFORM_SUBDOMAIN=platform

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Email (Development - Console backend)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
