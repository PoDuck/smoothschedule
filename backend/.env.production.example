# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING
DJANGO_ALLOWED_HOSTS=smoothschedule.com,*.smoothschedule.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# Database (Use Managed PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/database
CONN_MAX_AGE=60

# Redis (Use Managed Redis)
REDIS_URL=redis://redis-host:6379/0

# Multi-Tenancy
TENANT_DOMAIN_SUFFIX=.smoothschedule.com
PLATFORM_SUBDOMAIN=platform

# CORS
CORS_ALLOWED_ORIGINS=https://smoothschedule.com,https://app.smoothschedule.com

# Email (Production - Mailgun/SendGrid)
DJANGO_EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=SmoothSchedule <noreply@smoothschedule.com>
DJANGO_SERVER_EMAIL=SmoothSchedule <server@smoothschedule.com>
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.smoothschedule.com

# AWS/Storage (Optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# Sentry (Optional - Error Tracking)
# SENTRY_DSN=https://your-sentry-dsn
